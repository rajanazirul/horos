{
  "name": "@horos/skill",
  "version": "0.0.0",
  "private": true,
  "description": "Claude Code plugin (horos-quickstart skill) and the horos-quickstart CLI: wire Horos into a USDC-paying agent in under ten minutes",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "horos-quickstart": "./dist/cli.js"
  },
  "files": [
    "dist",
    "plugin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-demo-list.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@horos/schema": "workspace:*",
    "@horos/sdk": "workspace:*",
    "viem": "2.56.9"
  }
}
