      "checkConstraints": {
        "scope_kind_valid": {
          "name": "scope_kind_valid",
          "value": "\"scope\".\"kind\" IN ('enforced', 'shadow', 'advisory-public')"
        },
        "scope_id_matches_kind": {
          "name": "scope_id_matches_kind",
          "value": "CASE \"scope\".\"kind\" WHEN 'advisory-public' THEN \"scope\".\"id\" = 'advisory-public' ELSE \"scope\".\"id\" ~ ('^' || \"scope\".\"kind\" || ':[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$') END"
        },
        "scope_enforced_has_policy_wallet": {
          "name": "scope_enforced_has_policy_wallet",
          "value": "\"scope\".\"kind\" <> 'enforced' OR \"scope\".\"policy_wallet\" IS NOT NULL"
        },
        "scope_shadow_has_customer": {
          "name": "scope_shadow_has_customer",
          "value": "\"scope\".\"kind\" <> 'shadow' OR \"scope\".\"customer_id\" IS NOT NULL"
        },
        "scope_policy_wallet_valid": {
          "name": "scope_policy_wallet_valid",
          "value": "\"scope\".\"policy_wallet\" IS NULL OR \"scope\".\"policy_wallet\" ~ '^0x[0-9a-f]{40}$'"
        }
      },
