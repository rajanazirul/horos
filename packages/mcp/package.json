{
  "name": "@horos/mcp",
  "version": "0.0.0",
  "private": true,
  "description": "MCP server over the SDK: check plus read-only Decision Log tools",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "horos-mcp": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@horos/schema": "workspace:*",
    "@horos/sdk": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.1",
    "viem": "2.56.9",
    "zod": "4.6.5"
  }
}
