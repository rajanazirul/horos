{
  "name": "@horos/sdk",
  "version": "0.0.0",
  "private": true,
  "description": "typed Horos client: signed check(), read-only records",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "artifact:generate": "node scripts/gen-artifact.mjs"
  },
  "dependencies": {
    "@horos/schema": "workspace:*",
    "viem": "2.56.9"
  }
}
